    <dashboard name='Global Fuel Prices and Taxation Story' type='storyboard'>
      <style />
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='4357' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone h='10477' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='5187' />
            <zone h='83506' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='15664'>
              <flipboard active-id='7' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Introduction: This report compares weekly petrol, diesel, LPG and Brent crude prices with fuel tax across 84 countries and seven regions from 2020 to April 2026. Use the dashboard to explore regional, temporal and economic differences; the comparisons are descriptive and do not establish causation.' captured-sheet='Global Fuel Prices Dashboard' id='1'>
                    <capturedDeltas>
                      <worksheet name='Sheet 3'>
                        <selection-collection>
                          <tuple-selection>
                            <tuple-reference>
                              <tuple-descriptor>
                                <pane-descriptor>
                                  <x-fields>
                                    <field>[federated.1oxjvv10029ufp1b51a3m13qdy4o].[tyr:date:qk]</field>
                                  </x-fields>
                                  <y-fields>
                                    <field>[federated.1oxjvv10029ufp1b51a3m13qdy4o].[avg:petrol_usd_liter:qk]</field>
                                  </y-fields>
                                </pane-descriptor>
                                <columns>
                                  <field>[federated.1oxjvv10029ufp1b51a3m13qdy4o].[avg:petrol_usd_liter:qk]</field>
                                  <field>[federated.1oxjvv10029ufp1b51a3m13qdy4o].[none:income_level:nk]</field>
                                  <field>[federated.1oxjvv10029ufp1b51a3m13qdy4o].[tyr:date:qk]</field>
                                </columns>
                              </tuple-descriptor>
                              <tuple>
                                <value>1.8494408866995071</value>
                                <value>&quot;Middle&quot;</value>
                                <value>#2026-01-01 00:00:00#</value>
                              </tuple>
                            </tuple-reference>
                          </tuple-selection>
                        </selection-collection>
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='Geographic disparity: Average petrol prices differ sharply by region. Europe and Oceania are highest in this dataset, while the Middle East is lowest.' captured-sheet='Sheet 2' id='2' />
                  <story-point caption='Income context: The dataset separates countries into income categories, and the price patterns differ across those groups. This comparison is descriptive; country income is not household affordability.' captured-sheet='Sheet 3' id='3' />
                  <story-point caption='Regional context: Country-level averages are grouped into seven regions. Differences in fuel price reflect many market and policy factors and should not be attributed to one category alone.' captured-sheet='Sheet 4' id='4' />
                  <story-point caption='Taxation: Country tax averages vary widely. The comparison shows association and does not establish that tax rates alone drive pump prices.' captured-sheet='Sheet 5' id='5' />
                  <story-point caption='Temporal trend: Petrol price averages rose from 2020 to 2022, eased in 2023, and were higher by April 2026. The 2026 value covers only part of the year.' captured-sheet='Global Petrol Trend' id='6' />
                  <story-point caption='Conclusion and recommendations: Use the regional and annual comparisons to identify where deeper country analysis is needed. Combine price and tax trends with current market data, and avoid treating these averages as a direct affordability or causal measure.' captured-sheet='Global Fuel Prices Dashboard' id='7' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
